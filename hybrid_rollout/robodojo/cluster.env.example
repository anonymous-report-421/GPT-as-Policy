# One container = one explicit frozen case. Use a fresh experiment ID per launch.
# Explicit identity: galbot | koozhan | codex_a[_2|_3] | codex_b[_2|_3|_4|_5].
# B's three slots require independent logins, never copied refresh tokens.
# Prefer acp prepare --auth-profile NAME, which resolves the correct credential.
ROLLOUT_AUTH_PROFILE=galbot
# API gateways bypass the container proxy; managed accounts use the image's
# normal HTTPS/proxy configuration unless an explicit proxy file is supplied.
# Managed subscription jobs can use: acp prepare --https-proxy-file <shared-private-file>
# ROLLOUT_HTTPS_PROXY_FILE=/mnt/rollout/robodojo_mixed_control/private/company_https_proxy.url
# The file contains the authenticated proxy URL and must be user-owned mode0600.
# Never inline that URL into the public submission script or commit credentials.
ROLLOUT_GATEWAY_NO_PROXY=gateway.example.invalid
ROLLOUT_EXPERIMENT_ID=robodojo_panel_v1
ROBODOJO_TASK=build_tower
ROLLOUT_REPLICA_ID=6
ROLLOUT_COUNT=1
ROLLOUT_CASE_ID=build_tower__standard__g0__l0
# Reuse the SAME manifest/SHA for pi05-only, GPT-only and hybrid paired evaluation.
ROLLOUT_EVAL_MANIFEST=/mnt/rollout/robodojo_mixed_control/evaluation/robodojo_panel60_v1.json
# Set to the panel_sha256 INSIDE that JSON; no ambiguous SEED_BASE is accepted.
ROLLOUT_EVAL_MANIFEST_SHA256=SET_FROM_FROZEN_MANIFEST
ROLLOUT_ATTEMPT=0
ROLLOUT_SHARED_ROOT=/mnt/rollout/robodojo_mixed_control
# Every episode: results/EXPERIMENT/TASK/VARIANT/eval_seed_G/layout_L/replica_ID/attempt_N/
# 7 tasks: standard layout 0..5; 3 generalization tasks: standard 0..2 + random 0..2.
# Replica summary: results/EXPERIMENT/_replicas/replica_ID/attempt_N/batch.json
# Submission/source/bootstrap logs: cluster/EXPERIMENT/replica_ID/
# Private per-episode Codex state/logs/caches: private_runtime/EXPERIMENT/replica_ID/attempt_N/

# Existing image only. All setup is in the entrypoint, no Dockerfile.
ROLLOUT_IMAGE_REF=registry.example.org/your-team/rollout:your-verified-image
CODE_ROOT=/workspace/eval-of-gpt-6-astra-as-policy
RUNTIME_ROOT=/mnt/rollout/robodojo_mixed_control
ROBODOJO_SOURCE=/mnt/rollout/robodojo_mixed_control/src/RoboDojo
OPENPI_SOURCE=/mnt/rollout/robodojo_mixed_control/src/RoboDojo/XPolicyLab/policy/Pi_05/openpi
ROBODOJO_PYTHON=/mnt/rollout/robodojo_mixed_control/sim-venv/bin/python
OPENPI_PYTHON=/mnt/rollout/openpi_mailbox_repro/openpi-venv/bin/python
CHECKPOINT=/mnt/rollout/robodojo_mixed_control/checkpoints/RoboDojo-sim-arx_x5-joint-0/59999
OPENPI_DATA_HOME=/mnt/rollout/openpi_mailbox_repro/openpi-cache
CODEX_BIN=/home/runner/.vscode-server/extensions/openai.chatgpt-26.903.71938-linux-x64/bin/linux-x86_64/codex
ROLLOUT_CODEX_VERSION=0.153.4
ROLLOUT_RUN_UID=10068
ROLLOUT_RUN_GID=10068
DAGGER_GRAPHICS_ROOT=/home/runner/.local/share/robolab-runtime
# Entry selects NVIDIA-Linux-x86_64-<actual node driver> beneath GRAPHICS_ROOT.
# Optional explicit overrides:
# DAGGER_NVIDIA_RUNTIME=/mnt/shared/graphics/NVIDIA-Linux-x86_64-570.172.08
# DAGGER_SYSROOT=/mnt/shared/graphics/sysroot
# LD_LIBRARY_PATH=
# SIM_EXTRA_PYTHONPATH=
# DEBUG_VIDEO_FONT=/mnt/shared/fonts/NotoSansCJKsc-Regular.otf

# Inject a credential file path through ACP --env; never inject its value into
# the publicly queryable scheduler configuration. Protect parent dir 0700/file 0600.
# ROLLOUT_OPENAI_API_KEY_FILE=/mnt/rollout/robodojo_mixed_control/private/galbot.key
# OPENAI_API_KEY is also accepted when the scheduler offers a true secret env.

POLICY_GPU=0
SIM_GPU=1
POLICY_PORT=18830
SIM_PORT=19113
# User-confirmed panel evaluation: native step limit only; 0 disables these caps.
MAX_DECISIONS=0
CODEX_MAX_TOTAL_TOKENS=0
# Teacher-only preview: 640x480 -> 480x360. 0 disables; pi05/raw archive unchanged.
CODEX_IMAGE_MAX_EDGE=480
ROLLOUT_MAX_SECONDS=0

# Internal derived env, not scheduler inputs:
# ROLLOUT_SCHEDULER_JOB_ID, ROLLOUT_INDEX, TASK, SEED (=layout_id), EVAL_SEED, RESULTS_ROOT,
# ROLLOUT_EVAL_SEED, ROLLOUT_LAYOUT_ID, ROLLOUT_BASE_TASK, ROLLOUT_VARIANT,
# ROLLOUT_CASE_FILE, ROLLOUT_ARCHIVE, ROBODOJO_RUN_ID,
# RUN_ID, TASK_ROOT, ROLLOUT_CODEX_HOME_DIR, ROLLOUT_CODEX_CONFIG,
# ROLLOUT_CREDENTIAL_SOURCE, PYTHONUNBUFFERED, PYTHONDONTWRITEBYTECODE,
# ROLLOUT_BOOTSTRAP_LOG, PATH (inherited + installation directories), TMPDIR,
# XDG_CONFIG_HOME, XDG_DATA_HOME, XDG_STATE_HOME,
# CUDA_VISIBLE_DEVICES, XLA_PYTHON_CLIENT_PREALLOCATE, PYTHONPATH,
# NO_PROXY/no_proxy=127.0.0.1,localhost,gateway.example.invalid,
# XDG_CACHE_HOME, CUDA_CACHE_PATH, TORCH_EXTENSIONS_DIR, MPLCONFIGDIR,
# VK_ICD_FILENAMES, __EGL_VENDOR_LIBRARY_FILENAMES, XDG_RUNTIME_DIR,
# OMNI_KIT_ACCEPT_EULA. Launch manifest archives public resolved values only.
